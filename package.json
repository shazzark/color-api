{
  "name": "color-api",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic color conversion, analysis, generation, and design token tools.",
  "type": "module",
  "main": "./dist/package/index.js",
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js"
    }
  },
  "files": [
    "dist/package",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.package.json && npm run openapi:generate",
    "build:server": "tsc -p tsconfig.server.json",
    "build:package": "tsc -p tsconfig.package.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package:types": "tsc -p tsconfig.consumer.json --noEmit",
    "package:smoke": "node scripts/package-smoke.mjs",
    "package:contents": "node scripts/check-package-contents.mjs",
    "package:stage": "node scripts/stage-package.mjs",
    "package:tarball-smoke": "node scripts/package-tarball-smoke.mjs",
    "release:stage": "node scripts/stage-production.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "container:smoke": "node scripts/container-smoke.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/check-openapi.mjs",
    "browser:smoke:serve": "node scripts/browser-smoke-server.mjs",
    "prepublishOnly": "npm run build && npm test && npm run package:types && npm run package:smoke"
  },
  "dependencies": {
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@redocly/openapi-core": "^2.57.0",
    "@types/node": "^22.15.0",
    "ajv": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
